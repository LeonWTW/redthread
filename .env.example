# RedThread environment configuration
# Copy to .env and fill in. NEVER commit .env (git-ignored).

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=redthread
POSTGRES_PASSWORD=change-me
POSTGRES_DB=redthread
# Used by the API/worker containers; host `postgres` is the compose service name.
DATABASE_URL=postgresql+psycopg2://redthread:change-me@postgres:5432/redthread

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Qdrant -------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333

# --- Flask --------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me

# Single analyst account, seeded from env (no registration, no reset, no user CRUD).
ANALYST_USERNAME=leon
ANALYST_PASSWORD=change-me

# Long-lived token for machine clients on POST /api/capture (header: X-API-Token).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_TOKEN=change-me

# --- Media --------------------------------------------------------------------
# Private volume path inside containers; served ONLY via authenticated routes.
MEDIA_ROOT=/data/media

# --- AI providers (runtime pipeline budget: <=$0.05/post, <=$50/month) ---------
# OCR / translation / extraction: Anthropic Haiku-class (cheapest adequate tier).
ANTHROPIC_API_KEY=sk-ant-...
# Embedding: OpenAI text-embedding-3-small (bilingual concat input).
OPENAI_API_KEY=sk-...

# Provider selection (swap implementations by config, not code)
OCR_PROVIDER=anthropic
TRANSLATION_PROVIDER=anthropic
EXTRACTION_PROVIDER=anthropic
EMBEDDING_PROVIDER=openai

# --- Backups (Backblaze B2; nightly pg_dump + media sync from the VPS) ---------
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=

# --- Restic (scripts/backup.sh + scripts/restore_drill.sh) ---------------------
# Where restic stores encrypted snapshots. Two forms:
#   Local repository (restore drills / before B2 exists):
#     RESTIC_REPOSITORY=/absolute/path/to/restic-repo
#   Backblaze B2 (production):
#     RESTIC_REPOSITORY=b2:$B2_BUCKET:redthread
#     restic reads the credentials as B2_ACCOUNT_ID=$B2_KEY_ID and
#     B2_ACCOUNT_KEY=$B2_APP_KEY; backup.sh maps them automatically.
RESTIC_REPOSITORY=
# Encryption password for the restic repository. Losing it = losing the
# backups. Keep an off-VPS copy (password manager).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RESTIC_PASSWORD=
